# Copy this file to .env and adjust the values for your home.
DASHBOARD_PORT=8080

SETTINGS_FILE=/data/settings/settings.json
LOCATION_NAME=Timisoara, Romania
LATITUDE=45.7489
LONGITUDE=21.2087

# celsius or fahrenheit; wind: kmh, mph, ms, kn
TEMPERATURE_UNIT=celsius
WIND_SPEED_UNIT=kmh

# true or false
SHOW_SECONDS=false
BLINK_SEPARATOR=true
# center, top, or fill
CLOCK_POSITION=center
LOCALE=en-GB
TIME_ZONE=Europe/Bucharest
FORECAST_DAYS=5

# Optional: use a local ./calendar/calendar.ics file, or a remote feed URL.
# The local file takes priority when both are present.
CALENDAR_ICS_FILE=/data/calendar/calendar.ics
CALENDAR_ICS_URL=http://better-f1-calendar.vercel.app/api/calendar.ics
CALENDAR_DAYS=7
CALENDAR_MAX_EVENTS=4

# Lower brightness between these hours. Set DIM_LEVEL=1 to disable dimming.
DIM_START=22
DIM_END=7
DIM_LEVEL=0.72

# Clock-only sleep schedule. Days use 0=Sunday through 6=Saturday.
SLEEP_ENABLED=false
SLEEP_START=23:00
SLEEP_END=07:00
SLEEP_DAYS=0,1,2,3,4,5,6
SLEEP_DIM_LEVEL=0.20
SLEEP_SHOW_SECONDS=false

# Moves the full layout a few pixels periodically to reduce uneven OLED wear.
BURN_IN_SHIFT=true
